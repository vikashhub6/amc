# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dynamic_cooling_amc?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# AWS S3 (photos, signatures, invoice PDFs are uploaded here directly - no local disk storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your-s3-bucket-name

# Email (Nodemailer). Leave EMAIL_USER/PASS blank in dev -> auto-creates a free
# Ethereal test inbox and logs a preview URL in the console for every email sent.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Dynamic Cooling AMC <no-reply@dynamiccooling.in>"

# SMS (placeholder - swap sendSMS.js internals for real MSG91/Fast2SMS call)
SMS_API_KEY=demo_key
SMS_SENDER_ID=DYNCOOL

# Company info (used in invoices / emails)
COMPANY_NAME=Dynamic Cooling System
COMPANY_CITY=Vapi, Gujarat

# Company/admin contact - "company side" of every dual-side alert lands here
# (in addition to being visible to admins inside the dashboard)
ADMIN_EMAIL=admin@dynamiccooling.in
ADMIN_PHONE=9999900000

# Frontend URL (used in renewal links inside emails, and as fallback CORS origin)
CLIENT_URL=https://your-frontend.vercel.app

# Comma-separated list of allowed frontend origins for CORS (overrides CLIENT_URL if set)
CORS_ORIGIN=https://your-frontend.vercel.app
