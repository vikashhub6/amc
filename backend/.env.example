# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/dynamic_cooling_amc

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email (Nodemailer). Leave EMAIL_USER/PASS blank in dev -> auto-creates a free
# Ethereal test inbox and logs a preview URL in the console for every email sent.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Dynamic Cooling AMC <no-reply@dynamiccooling.in>"

# SMS (placeholder - swap sendSMS.js internals for real MSG91/Fast2SMS call)
SMS_API_KEY=demo_key
SMS_SENDER_ID=DYNCOOL

# Company info (used in invoices / emails)
COMPANY_NAME=Dynamic Cooling System
COMPANY_CITY=Vapi, Gujarat

# Company/admin contact - "company side" of every dual-side alert lands here
# (in addition to being visible to admins inside the dashboard)
ADMIN_EMAIL=admin@dynamiccooling.in
ADMIN_PHONE=9999900000

# Frontend URL (used in renewal links inside emails)
CLIENT_URL=http://localhost:5173
